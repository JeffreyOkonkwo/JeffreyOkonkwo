// Delivery Health Report: DAX measures, by Jeffrey Okonkwo.
// Generated by build_pbip.py and identical to the measures inside the PBIP model (table _Measures).
// Model: dim_team[team] to fact_sprint, fact_flow, fact_throughput and fact_cfd [team];
//        dim_team[team] to fact_sprint_item[team] is inactive (the team filter reaches it through fact_sprint);
//        fact_sprint[sprint_id] to fact_sprint_item[sprint_id]; dim_issue[key] to fact_sprint_item[key] and fact_flow[key].
//        All single direction, one to many.

// ---- 1 Sprint predictability

Sprints = COUNTROWS ( fact_sprint )

Committed = SUM ( fact_sprint[committed] )

Committed Done = SUM ( fact_sprint[committed_done] )

Scope Added = SUM ( fact_sprint[added] )

Added Done = SUM ( fact_sprint[added_done] )

Total Done = SUM ( fact_sprint[total_done] )

Carried Over = SUM ( fact_sprint[carried_over] )

Removed = SUM ( fact_sprint[removed] )

Say-Do Ratio =
    // committed items finished in the sprint, over committed items at sprint start
    DIVIDE ( [Committed Done], [Committed] )

Say-Do Points = DIVIDE ( SUM ( fact_sprint[committed_pts_done] ), SUM ( fact_sprint[committed_pts] ) )

Scope Added % =
    // items added after the sprint started, over committed items at sprint start
    DIVIDE ( [Scope Added], [Committed] )

Say-Do by Sprint =
    // the say-do ratio of each sprint, averaged when more than one sprint is in context (for line charts)
    AVERAGEX (
        FILTER ( VALUES ( fact_sprint[sprint_id] ), CALCULATE ( [Committed] ) > 0 ),
        CALCULATE ( [Say-Do Ratio] )
    )

Say-Do Goal = 0.8

Sprints With Commitment = COUNTROWS ( FILTER ( fact_sprint, fact_sprint[committed] > 0 ) ) + 0

Sprints At 80% Say-Do =
    COUNTROWS (
        FILTER (
            fact_sprint,
            fact_sprint[committed] > 0
                && DIVIDE ( fact_sprint[committed_done], fact_sprint[committed] ) >= [Say-Do Goal]
        )
    ) + 0

Sprints At Goal Share = DIVIDE ( [Sprints At 80% Say-Do], [Sprints With Commitment] )

// ---- 2 Flow

Items Finished = COUNTROWS ( fact_flow )

Cycle Time P50 = PERCENTILE.INC ( fact_flow[cycle_days], 0.5 )

Cycle Time P85 = PERCENTILE.INC ( fact_flow[cycle_days], 0.85 )

Cycle Time Average = AVERAGE ( fact_flow[cycle_days] )

Cycle Days = SUM ( fact_flow[cycle_days] )

In Progress Days = SUM ( fact_flow[in_progress_days] )

Code Review Days = SUM ( fact_flow[code_review_days] )

Blocked Days = SUM ( fact_flow[blocked_days] )

Other Wait Days = SUM ( fact_flow[other_wait_days] )

Flow Efficiency =
    // time actively in progress, over total cycle time
    DIVIDE ( [In Progress Days], [Cycle Days] )

Code Review Share = DIVIDE ( [Code Review Days], [Cycle Days] )

Blocked Share = DIVIDE ( [Blocked Days], [Cycle Days] )

Other Wait Share = DIVIDE ( [Other Wait Days], [Cycle Days] )

Done Day =
    // days from 1 April 2025 to the day the item was finished (numeric x axis for the scatter)
    MIN ( fact_flow[done_day] )

Cycle Days Plot =
    // floors same-day items at 0.1 day so they can sit on a log scale
    VAR _d = [Cycle Days]
    RETURN
        IF ( ISBLANK ( _d ), BLANK (), MAX ( _d, 0.1 ) )

Throughput = SUM ( fact_throughput[done] )

CFD Items = SUM ( fact_cfd[items] )

// ---- 3 Backlog health

Items In 3+ Sprints =
    // issues that sat in three or more sprints; counted through sprint items so the team slicer applies
    CALCULATE ( DISTINCTCOUNT ( fact_sprint_item[key] ), dim_issue[sprints_touched] >= 3 ) + 0

Added Items = SUM ( fact_sprint_item[added] )

Unplanned Added Items = CALCULATE ( [Added Items], dim_issue[unplanned] = 1 )

Unplanned Share of Added =
    // bugs and build failures among the items added mid-sprint
    DIVIDE ( [Unplanned Added Items], [Added Items] )

Team Sprints =
    // sprints this item sat in for the selected team; blank when the team never had it
    DISTINCTCOUNT ( fact_sprint_item[sprint_id] )

Carried Items = SUM ( fact_sprint_item[carried] )

// ---- 9 Formatting

Team Colour = SWITCH ( SELECTEDVALUE ( dim_team[short] ), "Foundations", "#0C0E0D", "Persistence", "#8A8F8B", "Transactions", "#FF4A1C", "#0C0E0D" )

Say-Do Colour = IF ( NOT ISBLANK ( [Say-Do Ratio] ) && [Say-Do Ratio] < 0.5, "#FF4A1C", "#0C0E0D" )

Work Group Colour = IF ( SELECTEDVALUE ( dim_issue[work_group] ) = "Planned work", "#0C0E0D", "#FF4A1C" )

Type Colour = IF ( MAX ( dim_issue[unplanned] ) = 1, "#FF4A1C", "#0C0E0D" )
