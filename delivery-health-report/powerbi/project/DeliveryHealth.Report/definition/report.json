{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/1.2.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "DeliveryHealth.json",
      "reportVersionAtImport": "5.61",
      "type": "RegisteredResources"
    }
  },
  "layoutOptimization": "None",
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "DeliveryHealth.json",
          "path": "DeliveryHealth.json",
          "type": "CustomTheme"
        },
        {
          "name": "bg_overview.png",
          "path": "bg_overview.png",
          "type": "Image"
        },
        {
          "name": "bg_predictability.png",
          "path": "bg_predictability.png",
          "type": "Image"
        },
        {
          "name": "bg_flow.png",
          "path": "bg_flow.png",
          "type": "Image"
        },
        {
          "name": "bg_backlog.png",
          "path": "bg_backlog.png",
          "type": "Image"
        }
      ]
    }
  ],
  "settings": {
    "useStylableVisualContainerHeader": true,
    "exportDataMode": "AllowSummarized",
    "defaultDrillFilterOtherVisuals": true,
    "allowChangeFilterTypes": true,
    "useEnhancedTooltips": true,
    "useDefaultAggregateDisplayName": true
  }
}