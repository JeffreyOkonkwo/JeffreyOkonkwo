        "partitions": [
          {
            "name": "dim_issue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(DataRoot & \"dim_issue.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"key\", type text}, {\"type\", type text}, {\"priority\", type text}, {\"points\", type number}, {\"status\", type text}, {\"created\", type date}, {\"resolved\", type date}, {\"sprints_touched\", Int64.Type}, {\"unplanned\", Int64.Type}}, \"en-US\"),",
                "    Group = Table.AddColumn(Typed, \"work_group\", each if [unplanned] = 1 then [type] else \"Planned work\", type text),",
                "    GroupOrder = Table.AddColumn(Group, \"work_group_order\", each if [work_group] = \"Planned work\" then 3 else if [work_group] = \"Bug\" then 1 else 2, Int64.Type),",
                "    Band = Table.AddColumn(GroupOrder, \"sprint_band\", each if [sprints_touched] >= 3 then \"3 or more\" else \"1 or 2\", type text),",
                "    Result = Band",
                "in",
                "    Result"
              ]
            }
          }
        ]
      }
