      }
    ],
    "expressions": [
      {
        "name": "DataRoot",
        "kind": "m",
        "expression": "\"https://raw.githubusercontent.com/JeffreyOkonkwo/JeffreyOkonkwo/main/will-my-vote-count/powerbi/\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataRoot\", \"fact_comments\", \"fact_comment_theme\", \"dim_theme\", \"dim_step\", \"dim_video\", \"fact_results_2023\", \"fact_problem\", \"dim_fix\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
