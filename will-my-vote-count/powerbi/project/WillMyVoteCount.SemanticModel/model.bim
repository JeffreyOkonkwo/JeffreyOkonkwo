            "sourceColumn": "theme",
            "summarizeBy": "none"
          },
          {
            "name": "process_step",
            "dataType": "string",
            "sourceColumn": "process_step",
            "summarizeBy": "none"
          },
          {
            "name": "fix",
            "dataType": "string",
            "sourceColumn": "fix",
            "summarizeBy": "none"
          },
          {
            "name": "owner",
            "dataType": "string",
            "sourceColumn": "owner",
            "summarizeBy": "none"
          },
          {
            "name": "before_jan_2027",
            "dataType": "string",
            "sourceColumn": "before_jan_2027",
            "summarizeBy": "none"
          },
          {
            "name": "needs_new_law",
            "dataType": "string",
            "sourceColumn": "needs_new_law",
            "summarizeBy": "none"
          },
          {
            "name": "evidence",
            "dataType": "string",
            "sourceColumn": "evidence",
            "summarizeBy": "none"
          },
          {
            "name": "quick_win",
            "dataType": "string",
            "sourceColumn": "quick_win",
            "summarizeBy": "none"
          },
          {
            "name": "fix_order",
            "dataType": "int64",
            "sourceColumn": "fix_order",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dim_fix",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(DataRoot & \"dim_fix.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"fix_id\", type text}, {\"theme\", type text}, {\"process_step\", type text}, {\"fix\", type text}, {\"owner\", type text}, {\"before_jan_2027\", type text}, {\"needs_new_law\", type text}, {\"evidence\", type text}, {\"quick_win\", type text}}, \"en-US\"),",
                "    Ordered = Table.AddColumn(Typed, \"fix_order\", each Number.FromText(Text.Middle([fix_id], 1)), Int64.Type),",
                "    Result = Ordered",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Fixes Proposed",
            "expression": "COUNTROWS ( dim_fix )",
            "formatString": "0",
            "displayFolder": "Fixes"
          },
          {
            "name": "Quick Wins",
            "expression": "CALCULATE ( COUNTROWS ( dim_fix ), dim_fix[quick_win] = \"Quick win\" )",
            "formatString": "0",
            "displayFolder": "Fixes"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "926380fccd41",
        "fromTable": "fact_comment_theme",
        "fromColumn": "comment_id",
        "toTable": "fact_comments",
        "toColumn": "comment_id",
        "crossFilteringBehavior": "bothDirections"
      },
      {
        "name": "5e3231d30b31",
        "fromTable": "fact_comment_theme",
        "fromColumn": "theme",
        "toTable": "dim_theme",
        "toColumn": "theme"
      },
      {
