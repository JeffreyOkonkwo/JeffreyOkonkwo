// Beat the Delay: DAX measures (generated by build_pbip.py, identical to the measures inside the PBIP model)
// The PBIP already contains all of these. For a manual build, add them to fact_delays (or a _Measures table).
// Model: fact_delays[Date] -> dim_date[Date], [Hour] -> dim_hour[Hour], [Station] -> dim_station[Station],
//        [Cause] -> dim_cause[Cause], [Line] -> dim_line[Line]. All single direction, many to one.

// ---- Core

Minutes Lost = SUM ( fact_delays[Minutes] )

Hours Lost = DIVIDE ( [Minutes Lost], 60 )

Delays = COUNTROWS ( fact_delays )

Average Stop = DIVIDE ( [Minutes Lost], [Delays] )

Median Stop = MEDIAN ( fact_delays[Minutes] )

Days in Period = COUNTROWS ( dim_date )

Delays per Day = DIVIDE ( [Delays], [Days in Period] )

Minutes Lost MoM % =
    VAR cur = [Minutes Lost]
    VAR prev = CALCULATE ( [Minutes Lost], DATEADD ( dim_date[Date], -1, MONTH ) )
    RETURN
        DIVIDE ( cur - prev, prev )

// ---- Causes

People Minutes = CALCULATE ( [Minutes Lost], dim_cause[Cause Type] = "People-related" )

People Share = DIVIDE ( [People Minutes], [Minutes Lost] )

Weather Minutes = CALCULATE ( [Minutes Lost], dim_cause[Cause] = "Weather" )

Long Delays = CALCULATE ( [Delays], fact_delays[Minutes] > 10 )

Long Delay Share = DIVIDE ( [Long Delays], [Delays] )

// ---- Time of day

Rush Hour Uplift =
    // Weekday delays per hour in the rush periods (6 to 10 a.m., 3 to 7 p.m.) against midday (10 a.m. to 3 p.m.)
    VAR RushDelays = CALCULATE ( [Delays], dim_date[Day Type] = "Weekday", dim_hour[Period] IN { "Morning rush", "Evening rush" } )
    VAR RushHours = CALCULATE ( COUNTROWS ( dim_hour ), dim_hour[Period] IN { "Morning rush", "Evening rush" } )
    VAR MidDelays = CALCULATE ( [Delays], dim_date[Day Type] = "Weekday", dim_hour[Hour] IN { 10, 11, 12, 13, 14 } )
    VAR MidHours = CALCULATE ( COUNTROWS ( dim_hour ), dim_hour[Hour] IN { 10, 11, 12, 13, 14 } )
    RETURN
        DIVIDE ( DIVIDE ( RushDelays, RushHours ), DIVIDE ( MidDelays, MidHours ) ) - 1

Peak Delay Hour =
    VAR t = TOPN ( 1, VALUES ( dim_hour[Hour Label] ), [Delays], DESC )
    RETURN
        CONCATENATEX ( t, dim_hour[Hour Label], ", " )

// ---- Stations

Station Minutes Lost = IF ( SELECTEDVALUE ( dim_station[Station] ) = "Line-wide or yard", BLANK (), [Minutes Lost] )

Worst Station =
    VAR t =
        TOPN ( 1, FILTER ( VALUES ( dim_station[Station] ), dim_station[Station] <> "Line-wide or yard" ), [Minutes Lost], DESC )
    RETURN
        MAXX ( t, dim_station[Station] )

Worst Station Minutes =
    VAR s = [Worst Station]
    RETURN
        CALCULATE ( [Minutes Lost], dim_station[Station] = s )

// ---- Plan My Ride

Delay Rate per 100 Days = DIVIDE ( [Delays], [Days in Period] ) * 100

Station Baseline per 100 Slots =
    // average delays per service hour (21 a day) at the chosen station, over every day in the data
    VAR st = CALCULATE ( [Delays], REMOVEFILTERS ( dim_hour ), REMOVEFILTERS ( dim_date ) )
    VAR slots = CALCULATE ( COUNTROWS ( dim_date ), REMOVEFILTERS ( dim_date ) ) * 21
    RETURN
        DIVIDE ( st, slots ) * 100

Risk Ratio = DIVIDE ( [Delay Rate per 100 Days], [Station Baseline per 100 Slots] )

Verdict =
    SWITCH (
        TRUE (),
        [Delays] = 0, "Green light",
        [Risk Ratio] < 0.75, "Green light",
        [Risk Ratio] < 1.5, "Steady pace",
        "Headwind"
    )

Buffer Minutes = IF ( [Delays] = 0, 0, MAX ( 5, CEILING ( ROUND ( [Average Stop], 0 ), 5 ) ) )

Delay Chance = DIVIDE ( DISTINCTCOUNT ( fact_delays[Date] ), [Days in Period] ) + 0

Slot Delays = [Delays] + 0

Slot Average Stop = COALESCE ( [Average Stop], 0 )

// ---- Formatting

Verdict Colour = SWITCH ( [Verdict], "Green light", "#2FB36B", "Steady pace", "#F5F6F8", "#D7322B" )

Cause Colour = IF ( SELECTEDVALUE ( dim_cause[Cause Type] ) = "People-related", "#D7322B", "#7D838D" )

Hour Colour = IF ( SELECTEDVALUE ( dim_hour[Period] ) IN { "Morning rush", "Evening rush" }, "#D7322B", "#7D838D" )

Station Colour =
    VAR _top = MAXX ( ALLSELECTED ( dim_station[Station] ), [Station Minutes Lost] )
    RETURN
        IF ( [Station Minutes Lost] = _top, "#D7322B", "#7D838D" )

Month Colour =
    VAR _top = MAXX ( ALLSELECTED ( dim_date[Month], dim_date[Month Start] ), [Minutes Lost] )
    RETURN
        IF ( [Minutes Lost] = _top, "#D7322B", "#7D838D" )

Heat Colour =
    VAR _top =
        MAXX (
            CROSSJOIN (
                ALLSELECTED ( dim_date[Weekday Short], dim_date[Weekday Number] ),
                ALLSELECTED ( dim_hour[Hour Short], dim_hour[Service Hour Order] )
            ),
            [Delays]
        )
    VAR r = DIVIDE ( [Delays], _top )
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( r ), "#15171C",
            r >= 0.85, "#D7322B",
            r >= 0.70, "#A92B26",
            r >= 0.55, "#7E2522",
            r >= 0.40, "#57201F",
            r >= 0.25, "#3A1C1D",
            "#26191B"
        )
