                "color": "#F5F6F8"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#1E2128"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F5F6F8"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#15171C"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F5F6F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
